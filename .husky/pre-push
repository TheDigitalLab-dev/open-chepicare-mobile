set -e

echo "▶ pre-push: ESLint --fix + Prettier + lint + typecheck"

# 1) Autocorrige lo que se pueda (no abortar aún: los errores no-corregibles
#    los detecta el lint estricto más abajo).
pnpm lint:fix || true
pnpm format

# 2) Si lint --fix / prettier modificaron archivos rastreados, bloquear el push:
#    el dev debe revisar y commitear esos cambios antes de volver a empujar.
if ! git diff --quiet; then
  echo ""
  echo "✖ ESLint --fix / Prettier modificaron archivos. Revísalos y crea un nuevo"
  echo "  commit con esos cambios antes de hacer push:"
  echo ""
  git --no-pager diff --stat
  exit 1
fi

# 3) Compuertas duras: lint sin errores y tipos correctos (set -e aborta el push).
pnpm lint
pnpm typecheck

echo "✓ pre-push OK"
